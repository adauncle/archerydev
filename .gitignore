# ========== 合并自上游 Archery .gitignore ==========
*.pyc
*.swp
*.lock
*.log
.idea/
.DS_Store
Thumbs.db
*.tmp
.archery/settings.py.github
.archery/settings.py.dev
archery/settings_dev.py
sql/migrations/
venv
env
.venv/
__pycache__/
dist/
*.egg-info/
sonar-project.properties
.scannerwork
.env
local_settings.py
src/docker-compose-dev
.coverage
coverage.xml
archery_custom
static/
nohup.out

# ========== Python / Django ==========
*$py.class
*.so
.Python
ENV/
.eggs/
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
.tox/
.cache/
.pytest_cache/
htmlcov/
.mypy_cache/
.ruff_cache/

# Django media/static（不要提交到 git）
media/
static/
!media/.gitkeep
!static/.gitkeep

# ========== Node / Frontend ==========
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.parcel-cache/
.vite/
.next/
.nuxt/

# ========== MySQL / Redis data ==========
*.sql
*.sql.gz
!docs/**/*.sql
!scripts/**/*.sql
!migrations/**/*.sql
data/
mysql_data/
redis_data/
downloads/

# ========== Docker ==========
.docker/
docker-compose.override.yml

# ========== IDE ==========
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ========== Logs & runtime ==========
logs/
*.log.*
celerybeat-schedule
celerybeat.pid
nohup.out

# ========== Secrets ==========
*.pem
*.key
*.crt
secrets/
credentials/
