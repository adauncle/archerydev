# ========== 合并自上游 Archery .gitignore ==========
*.pyc
*.swp
*.lock
*.log
.idea/
.DS_Store
Thumbs.db
*.tmp
.archery/settings.py.github
.archery/settings.py.dev
archery/settings_dev.py
sql/migrations/
venv
env
.venv/
__pycache__/
/dist/
*.egg-info/
sonar-project.properties
.scannerwork
.env
local_settings.py
src/docker-compose-dev
.coverage
coverage.xml
archery_custom
/static/
nohup.out

# ========== Python / Django ==========
*$py.class
*.so
.Python
ENV/
.eggs/
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
.tox/
.cache/
.pytest_cache/
htmlcov/
.mypy_cache/
.ruff_cache/

# Django media/static（不要提交到 git）
media/
/static/
!media/.gitkeep
!/static/.gitkeep

# ========== Node / Frontend ==========
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.parcel-cache/
.vite/
.next/
.nuxt/

# ========== MySQL / Redis data ==========
*.sql
*.sql.gz
!docs/**/*.sql
!scripts/**/*.sql

# ========== 部署/调试临时脚本（不 commit，由 agent 在调试时按需创建）==========
scripts/deploy/check*.sh
scripts/deploy/check*.py
scripts/deploy/debug*.sh
scripts/deploy/fix*.sh
scripts/deploy/fix*.py
scripts/deploy/test*.sh
scripts/deploy/dbg.sh
scripts/deploy/chk.sh
scripts/deploy/fw.sh
scripts/deploy/clean*.sh
scripts/deploy/try*.sh
scripts/deploy/restart*.sh
scripts/deploy/probe*.sh
scripts/deploy/run*.sh
scripts/deploy/start*.sh
scripts/deploy/stop*.sh
scripts/deploy/inspect.sh
scripts/deploy/diag*.sh
scripts/deploy/login*.sh
scripts/deploy/reset*.sh
scripts/deploy/retry*.sh
scripts/deploy/manual*.sh
scripts/deploy/regen*.sh
scripts/deploy/repo*.sh
scripts/deploy/final*.sh
scripts/deploy/find*.sh
scripts/deploy/create*.sh
scripts/deploy/install*.sh
scripts/deploy/get*.sh
scripts/deploy/mig*.sh
scripts/deploy/report*.sh
scripts/deploy/root*.sh
scripts/deploy/init*.sh
scripts/deploy/extract*.py
scripts/deploy/verify*.sh
scripts/deploy/generate*.sh
# 二进制包（cloudflared 等在服务器上 wget 装，本地不 commit）
*.rpm
# 但保留正式部署脚本和 systemd unit
!scripts/deploy/01_init_server.sh
!scripts/deploy/02_deploy.sh
!scripts/deploy/03_rollback.sh
!scripts/deploy/04_backup.sh
!scripts/deploy/check_health.sh
!scripts/deploy/systemd/
!scripts/deploy/cloudflared/
!scripts/deploy/README.md
!migrations/**/*.sql
data/
mysql_data/
redis_data/
downloads/

# ========== Docker ==========
.docker/
docker-compose.override.yml

# ========== IDE ==========
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ========== Logs & runtime ==========
logs/
*.log.*
celerybeat-schedule
celerybeat.pid
nohup.out

# ========== Secrets ==========
*.pem
*.key
*.crt
secrets/
credentials/
