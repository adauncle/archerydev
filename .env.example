# ========== Django ==========
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ========== MySQL（应用元数据）==========
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=archery
MYSQL_PASSWORD=archery
MYSQL_DB=archery

# ========== Redis ==========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== Celery ==========
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ========== 通知 ==========
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
WECOM_WEBHOOK=
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ========== LDAP（可选）==========
LDAP_ENABLED=False
LDAP_SERVER=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_USER_DN_TEMPLATE=

# ========== 内部定制开关 ==========
CUSTOM_ENABLE_DATA_MASKING=True
CUSTOM_ENABLE_AUDIT_LOG_ENHANCED=True
CUSTOM_INTERNAL_DEPT_SSO=False

# ========== 钉钉 OA 审批（v0.2.0+，灰度发布，默认 False）==========
CUSTOM_DINGTALK_OA_ENABLED=False
DINGTALK_OA_APP_KEY=
DINGTALK_OA_APP_SECRET=
DINGTALK_OA_AGENT_ID=
DINGTALK_OA_CALLBACK_TOKEN=
DINGTALK_OA_CALLBACK_AES_KEY=
DINGTALK_OA_CALLBACK_RECEIVEID=

# ========== gh-ost 无锁 DDL（v0.3.0-alpha+，灰度发布，默认 False）==========
# 设为 True 才加载 ddl_gh_ost app + 注册 URL 路由
# 启用后还要在 admin 里维护 DdlGhostTask 灰度名单（DBA 决定）
CUSTOM_GH_OST_ENABLED=False
CUSTOM_GH_OST_BIN=/usr/local/bin/gh-ost
CUSTOM_GH_OST_CUT_OVER_STRATEGY=immediate
CUSTOM_GH_OST_LOG_DIR=/var/log/archery/gh_ost
