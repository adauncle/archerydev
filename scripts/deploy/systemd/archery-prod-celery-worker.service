## CUSTOM-NEW: Archery 生产环境 celery worker 单元（演示用）@ 2026-07-20 @ devops-agent
##
## 设计依据：docs/designs/2026-07-20_devops-cicd.md §5.2
## 部署位置：服务器上 /etc/systemd/system/archery-prod-celery-worker.service
##
## 启用方式：
##   sudo cp scripts/deploy/systemd/archery-prod-celery-worker.service /etc/systemd/system/
##   sudo systemctl daemon-reload
##   sudo systemctl enable --now archery-prod-celery-worker.service
##   systemctl status archery-prod-celery-worker.service
##
## 对应 staging/dev 环境的 service 文件可由本文件派生（替换 WorkingDirectory 等）

[Unit]
Description=Archery Production Celery Worker (concurrency=4)
Documentation=https://github.com/adauncle/archerydev
After=network.target mysql.service redis-server.service
Requires=redis-server.service
# 注：CentOS 7 systemd 219 不支持 StartLimitInterval/Burst（230+ 才有）

[Service]
Type=simple
User=archery
Group=archery
WorkingDirectory=/opt/archery/prod
EnvironmentFile=/opt/archery/prod/.env

ExecStart=/opt/archery/prod/venv/bin/celery \
    -A archery worker \
    -l info \
    --concurrency=4

# 进程管理
Restart=always
RestartSec=5

# 安全加固（CentOS 7 systemd 219 兼容写法）
NoNewPrivileges=true
ProtectSystem=yes
ProtectHome=true
PrivateTmp=true
ReadWriteDirectories=/opt/archery /var/log/archery

# 资源限制
LimitNOFILE=65536
# 注：CentOS 7 systemd 219 不支持 MemoryMax/MemoryLimit（230+ 才有）

[Install]
WantedBy=multi-user.target
